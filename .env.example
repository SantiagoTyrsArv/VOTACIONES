# Redis compartido; en producción usa la URL segura inyectada por la plataforma.
REDIS_URL=redis://127.0.0.1:6379
PORT=3000
HOST=0.0.0.0
INSTANCE_ID=local-1
# Railway inyecta RAILWAY_REPLICA_ID automáticamente.

# Consola C: en modo real usa false y configura credenciales de al menos 24 caracteres.
DEMO_MODE=true
# AUDITOR_CREDENTIALS_JSON={"secreto-aleatorio":{"id":"ana","name":"Ana","role":"auditor"}}
# INTEGRATION_TOKEN=secreto-distinto-para-A
# ALLOWED_ORIGINS=https://consola.example.org
# Scripts de caos: ruta absoluta al ejecutable Docker, sin búsqueda mediante PATH.
# DOCKER_BIN=/usr/bin/docker
