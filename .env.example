# Copiar a .env y ajustar. Ninguna instancia conoce a otra: la única
# dependencia compartida es REDIS_URL (RT-3).
REDIS_URL=redis://localhost:6379
PORT=3000
HOST=0.0.0.0

# Railway lo inyecta en cada réplica; en local se puede fijar a mano.
RAILWAY_REPLICA_ID=local-1

# Ingesta (Persona A)
REDIS_TIMEOUT_MS=300
LIMITE_ACTAS_POR_MINUTO=30
