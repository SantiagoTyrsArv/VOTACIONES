# Copiar a .env y ajustar. Las instancias solo comparten Redis (RT-3).
REDIS_URL=redis://localhost:6379
PORT=3000

# Railway inyecta RAILWAY_REPLICA_ID; INSTANCE_ID permite fijarlo en local.
RAILWAY_REPLICA_ID=local-1
INSTANCE_ID=local-1
LOG_LEVEL=info

# Ingesta (Persona A)
REDIS_TIMEOUT_MS=300
LIMITE_ACTAS_POR_MINUTO=30
