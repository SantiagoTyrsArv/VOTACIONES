# Copiar a .env y ajustar. Las instancias solo comparten Redis (RT-3).
REDIS_URL=redis://127.0.0.1:6379
PORT=3000

# Railway inyecta RAILWAY_REPLICA_ID; INSTANCE_ID permite fijarlo en local.
RAILWAY_REPLICA_ID=local-1
INSTANCE_ID=local-1
LOG_LEVEL=info

# Ingesta (Persona A)
REDIS_TIMEOUT_MS=300
LIMITE_ACTAS_POR_MINUTO=30
# Credenciales firmadas de jurados (HMAC). Sin esta variable la ingesta acepta actas
# sin credencial: solo para desarrollo. Mínimo 32 caracteres, igual en las 8 réplicas.
# JURADO_SECRETO=

# Verificación (Persona C). En modo real: DEMO_MODE=false. No guardar credenciales en Git.
DEMO_MODE=true
# AUDITOR_CREDENTIALS_JSON={"secreto-aleatorio":{"id":"ana","name":"Ana","role":"auditor"}}
# INTEGRATION_TOKEN=secreto-distinto-para-A
# ALLOWED_ORIGINS=https://consola.example.org
# Prometheus: si se define, GET /metrics exige "Authorization: Bearer <METRICS_TOKEN>".
# METRICS_TOKEN=
