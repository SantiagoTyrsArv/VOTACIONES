{
  "name": "votaciones",
  "version": "0.1.0",
  "private": true,
  "description": "Preconteo electoral en tiempo real con ingesta, difusión y verificación sobre Redis",
  "type": "module",
  "engines": { "node": ">=22 <23" },
  "workspaces": ["shared", "server", "publico", "carga"],
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:common": "npm run dev -w server",
    "dev:console": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit && npm run typecheck --workspaces --if-present",
    "build": "tsc && vite build && npm run build --workspaces --if-present",
    "start": "node dist/server/index.js",
    "start:common": "npm run start -w server",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts && npm run test --workspaces --if-present",
    "check": "npm run typecheck && npm run build && npm test",
    "demo:seed": "tsx scripts/seed.ts",
    "smoke": "tsx scripts/smoke.ts",
    "carga:plan": "node carga/generate-profile.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:deploy": "tsx scripts/validate-deploy.ts",
    "smoke:chaos": "tsx scripts/chaos-smoke.ts"
  },
  "dependencies": {
    "@fastify/websocket": "^11.2.0",
    "fastify": "^5.6.0",
    "prom-client": "^15.1.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "redis": "^5.9.0",
    "ws": "^8.18.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^5.1.0",
    "playwright": "^1.64.1",
    "prettier": "^3.7.4",
    "railway": "^3.16.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  },
  "overrides": { "glob": "14.0.3", "minimatch": "11.0.1" }
}
