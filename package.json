{
  "name": "votaciones",
  "version": "0.1.0",
  "private": true,
  "description": "Preconteo electoral en tiempo real: ingesta, difusión pública y verificación sobre 8 instancias coordinadas por Redis.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "shared",
    "server",
    "jurado",
    "herramientas",
    "publico",
    "carga"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present && tsc && vite build",
    "start": "npm run start --workspace @votaciones/server",
    "dev": "npm run dev --workspace @votaciones/server",
    "dev:jurado": "npm run dev --workspace @preconteo/jurado --",
    "dev:publico": "npm run dev --workspace @votaciones/publico --",
    "test": "npm run test --workspaces --if-present && npm run test:c",
    "test:e2e": "playwright test",
    "typecheck": "npm run build -w @votaciones/shared && npm run typecheck --workspaces --if-present && tsc --noEmit && tsc -p tsconfig.web.json --noEmit",
    "redis:up": "docker compose up -d redis",
    "redis:down": "docker compose down",
    "dev:console": "vite --host 127.0.0.1",
    "check": "npm run typecheck && npm run build && npm test",
    "demo:seed": "tsx --conditions=development scripts/seed.ts",
    "smoke": "tsx --conditions=development scripts/smoke.ts",
    "carga:plan": "node carga/generate-profile.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke:chaos": "tsx scripts/chaos-smoke.ts",
    "test:c": "tsx --conditions=development --test --test-concurrency=1 tests/*.test.ts",
    "validate:deploy": "az bicep build --file deploy/azure/main.bicep --stdout"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.1.0",
    "playwright": "^1.64.1",
    "prettier": "^3.7.4",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  },
  "dependencies": {
    "fastify": "^5.12.8",
    "prom-client": "^15.1.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "redis": "^6.3.1",
    "ws": "^8.22.1",
    "zod": "^4.1.0"
  },
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.1"
  }
}
