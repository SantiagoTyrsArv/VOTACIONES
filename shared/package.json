{
  "name": "@votaciones/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Contrato compartido: actas, recibos, tópicos, claves de Redis y eventos públicos.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./verificacion": {
      "source": "./src/verificacion/contracts.ts",
      "development": "./src/verificacion/contracts.ts",
      "types": "./dist/verificacion/contracts.d.ts",
      "default": "./dist/verificacion/contracts.js"
    },
    "./verificacion/proposals": {
      "source": "./src/verificacion/proposals.ts",
      "development": "./src/verificacion/proposals.ts",
      "types": "./dist/verificacion/proposals.d.ts",
      "default": "./dist/verificacion/proposals.js"
    },
    "./credencial": {
      "source": "./src/credencial.ts",
      "development": "./src/credencial.ts",
      "types": "./dist/credencial.d.ts",
      "default": "./dist/credencial.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "zod": "^4.1.0"
  }
}
