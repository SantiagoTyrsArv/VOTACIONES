{
  "name": "@votaciones/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Contrato compartido: tópicos, claves de Redis, canales y formatos de mensaje",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./verificacion": {
      "development": "./src/verificacion/contracts.ts",
      "types": "./dist/verificacion/contracts.d.ts",
      "default": "./dist/verificacion/contracts.js"
    },
    "./verificacion/proposals": {
      "development": "./src/verificacion/proposals.ts",
      "types": "./dist/verificacion/proposals.d.ts",
      "default": "./dist/verificacion/proposals.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "zod": "^4.1.0"
  }
}
