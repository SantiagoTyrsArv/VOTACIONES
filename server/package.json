{
  "name": "@votaciones/server",
  "version": "0.1.0",
  "private": true,
  "description": "Instancia Node.js sin estado propio: ingesta, difusión pública y verificación",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsx watch --conditions=development src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@votaciones/shared": "0.1.0",
    "fastify": "^5.2.1",
    "prom-client": "^15.1.3",
    "redis": "^4.7.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "pino": "^9.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
