{
  "name": "@votaciones/server",
  "version": "0.1.0",
  "private": true,
  "description": "Instancia Node.js sin estado propio: ingesta, difusión pública y verificación.",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copiar-lua.mjs",
    "start": "node dist/main.js",
    "dev": "tsx watch --conditions=development src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/static": "^10.1.8",
    "@votaciones/shared": "0.1.0",
    "fastify": "^5.12.8",
    "prom-client": "^15.1.3",
    "redis": "^6.3.1",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/ws": "^8.18.2",
    "pino": "^9.14.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
